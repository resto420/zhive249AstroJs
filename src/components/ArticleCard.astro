---
interface Props {
  title: string;
  description: string;
  publishDate: string;
  author: {
    name: string;
    image: string;
    role: string;
  };
  category: string;
  image: string;
  slug: string;
}

const { title, description, publishDate, author, image, slug } = Astro.props;

// Format date
const date = new Date(publishDate);
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<article 
  class="group relative block rounded-2xl bg-gradient-to-b from-navy-900/90 to-navy-950/90 shadow-2xl shadow-navy-950/50 backdrop-blur-sm border border-navy-800/50 hover:-translate-y-1 hover:shadow-3xl hover:shadow-primary-500/20 transition-all duration-300"
>
  <a href={`/articles/${slug}`} class="block" aria-label={title}>
    <!-- Glow Effects -->
    <div class="absolute inset-0 rounded-2xl bg-gradient-to-b from-primary-500/5 to-primary-500/0 pointer-events-none"></div>
    <div class="absolute -inset-0.5 rounded-2xl bg-gradient-to-b from-primary-500/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 blur-xl pointer-events-none"></div>

    <!-- Image Container -->
    <div class="relative aspect-w-16 aspect-h-9 rounded-t-2xl overflow-hidden">
      <img
        src={image}
        alt={`Featured image for article: ${title}`}
        class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
        decoding="async"
      />
      <!-- Image Overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 to-transparent pointer-events-none"></div>
    </div>

    <!-- Content -->
    <div class="relative p-6">
      <h2 class="text-xl font-bold text-white mb-3 group-hover:text-primary-400 transition-colors duration-300 line-clamp-2">
        {title}
      </h2>

      <p class="text-navy-200 text-sm line-clamp-2 mb-4">
        {description}
      </p>

      <!-- Author and Date -->
      <div class="flex items-center justify-between mt-auto pt-4 border-t border-navy-700/30">
        <div class="flex items-center space-x-3">
          <div class="relative flex-shrink-0">
            <div class="absolute -inset-0.5 rounded-full bg-gradient-to-b from-primary-500 to-primary-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300 blur pointer-events-none"></div>
            <img
              src={author.image}
              alt={`Profile picture of ${author.name}`}
              class="relative w-10 h-10 rounded-full border-2 border-navy-700/50 group-hover:border-primary-500/50 transition-colors duration-300"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="flex flex-col min-w-0">
            <span class="text-sm font-medium text-white group-hover:text-primary-400 transition-colors duration-300 truncate">{author.name}</span>
            <span class="text-xs text-navy-300 truncate">{author.role}</span>
          </div>
        </div>
        <time datetime={publishDate} class="text-xs text-navy-400 flex-shrink-0">{formattedDate}</time>
      </div>
    </div>

    <!-- Card Border Glow -->
    <div class="absolute -inset-px rounded-2xl bg-gradient-to-b from-primary-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
  </a>
</article>
