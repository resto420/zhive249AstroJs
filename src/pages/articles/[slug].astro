---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/Container.astro';
import { articles } from '../../components/Data/articles.json';

export function getStaticPaths() {
  return Object.entries(articles).map(([slug, article]) => ({
    params: { slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const { slug } = Astro.params;

// Format date
const date = new Date(article.publishDate);
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout 
  title={`${article.title} - Zhive249 Digital Marketing Agency`}
  description={article.description}
>
  <article class="relative pt-32 pb-16">
    <!-- Background Elements -->
    <div class="absolute inset-0 bg-[url('/grid.svg')] bg-center [mask-image:linear-gradient(180deg,white,rgba(255,255,255,0))]"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-navy-900 to-navy-950"></div>
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-gradient-to-br from-primary-500/10 via-transparent to-transparent"></div>
    </div>

    <Container>
      <!-- Article Header -->
      <header class="relative max-w-4xl mx-auto text-center mb-16" data-aos="fade-up">
        <div class="flex items-center justify-center space-x-4 mb-6">
          <span class="px-4 py-1.5 text-sm font-medium text-primary-400 bg-primary-500/10 rounded-full border border-primary-500/20">
            {article.category}
          </span>
          <span class="text-navy-300">
            {formattedDate}
          </span>
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-8 bg-clip-text text-transparent bg-gradient-to-b from-white to-white/60">
          {article.title}
        </h1>

        <p class="text-lg text-navy-100 mb-12 max-w-3xl mx-auto">
          {article.description}
        </p>

        <!-- Author -->
        <div class="flex items-center justify-center space-x-4">
          <div class="relative">
            <div class="absolute -inset-0.5 rounded-full bg-gradient-to-b from-primary-500 to-primary-600 opacity-75 blur"></div>
            <img
              src={article.author.image}
              alt={article.author.name}
              class="relative w-16 h-16 rounded-full border-2 border-navy-700/50"
            />
          </div>
          <div class="text-left">
            <div class="text-lg font-medium text-white">{article.author.name}</div>
            <div class="text-sm text-navy-300">{article.author.role}</div>
          </div>
        </div>
      </header>

      <!-- Featured Image -->
      <div class="relative max-w-5xl mx-auto mb-16 rounded-2xl overflow-hidden shadow-2xl" data-aos="fade-up" data-aos-delay="100">
        <div class="absolute inset-0 bg-gradient-to-t from-navy-950/50 to-transparent mix-blend-overlay"></div>
        <img
          src={article.image}
          alt={article.title}
          class="w-full h-auto"
        />
      </div>

      <!-- Article Content -->
      <div class="relative max-w-3xl mx-auto" data-aos="fade-up" data-aos-delay="200">
        <div 
          class="prose prose-lg prose-invert max-w-none prose-headings:text-white prose-headings:font-bold prose-p:text-navy-100 prose-a:text-primary-400 hover:prose-a:text-primary-300 prose-strong:text-white prose-ul:text-navy-100 prose-ol:text-navy-100"
          set:html={article.content}
        />
      </div>

      <!-- Social Share -->
      <div class="relative max-w-3xl mx-auto mt-16 pt-8 border-t border-navy-800/50" data-aos="fade-up" data-aos-delay="300">
        <div class="flex items-center justify-between">
          <div class="text-sm text-navy-300">Share this article</div>
          <div class="flex items-center space-x-4">
            <a href={`https://twitter.com/intent/tweet?text=${article.title}&url=${Astro.url}`} target="_blank" rel="noopener noreferrer" class="text-navy-300 hover:text-primary-400 transition-colors">
              <span class="sr-only">Share on Twitter</span>
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"></path>
              </svg>
            </a>
            <a href={`https://www.linkedin.com/shareArticle?mini=true&url=${Astro.url}&title=${article.title}`} target="_blank" rel="noopener noreferrer" class="text-navy-300 hover:text-primary-400 transition-colors">
              <span class="sr-only">Share on LinkedIn</span>
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </Container>
  </article>
</Layout>
